DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
REVIEW_PASSWORD=REPLACE_WITH_UNIQUE_REVIEW_PASSWORD_AT_LEAST_8_CHARACTERS
APP_HOSTS=

# Required on hosted environments. Local server creates data/booking.key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOOKING_ENCRYPTION_KEY=
# Patient OTP delivery uses SMTP. Clinic appointment notifications remain suppressed.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
