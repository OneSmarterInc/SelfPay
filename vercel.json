{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{static/**,seed/**,core.py,geo.py,proximity.py,server.py,postgres_store.py,app-config.json,tools/generate_app_config.py}"
    }
  },
  "github": {
    "autoAlias": false
  },
  "git": {
    "deploymentEnabled": {
      "directory-data": false,
      "directory-sync-*": false,
      "main": false,
      "backup-*": false,
      "feature/cross-platform-pwa": false
    }
  }
}
