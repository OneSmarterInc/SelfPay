{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{static/**,seed/**,core.py,geo.py,server.py,postgres_store.py}"
    }
  },
  "github": {
    "autoAlias": false
  },
  "git": {
    "deploymentEnabled": {
      "directory-data": false,
      "directory-sync-*": false
    }
  }
}

